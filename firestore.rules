rules_version = '2';

// Règles de sécurité d'Escale.
// - Connexion anonyme obligatoire (faite automatiquement par l'appli).
// - Impossible de lister les voyages : il faut l'identifiant secret du lien d'invitation.
// - Types et tailles vérifiés pour éviter les abus.
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && tid.size() >= 16
        && request.resource.data.keys().hasOnly(['name', 'dest', 'start', 'end', 'people', 'home', 'cur', 'rate', 'budget', 'created', 'geo', 'lat', 'lng'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.dest is string && request.resource.data.dest.size() <= 80
        && request.resource.data.people is list && request.resource.data.people.size() <= 30
        && request.resource.data.start is string && request.resource.data.end is string;
      allow delete: if request.auth != null;

      match /items/{iid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && exists(/databases/$(database)/documents/trips/$(tid))
          && request.resource.data.type in ['act', 'exp', 'pay', 'todo', 'doc']
          && request.resource.data.keys().size() <= 25
          && (!('amount' in request.resource.data) || (request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount < 10000000000))
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 80))
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
        allow delete: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
